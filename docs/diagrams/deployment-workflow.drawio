<mxfile host="app.diagrams.net">
  <diagram name="Deployment workflow" id="Deployment-workflow">
    <mxGraphModel dx="1496" dy="1160" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="840" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="dev" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" value="Team Member&lt;br&gt;(git push)" vertex="1">
          <mxGeometry height="70" width="230" x="40" y="40" as="geometry" />
        </mxCell>
        <mxCell id="pr" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" value="Feature branch&lt;br&gt;then Pull Request" vertex="1">
          <mxGeometry height="70" width="230" x="40" y="150" as="geometry" />
        </mxCell>
        <mxCell id="checks" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" value="PR checks (GitHub Actions)&lt;br&gt;lint, unit tests, docker build&lt;br&gt;(no push, no GCP credentials)" vertex="1">
          <mxGeometry height="90" width="230" x="40" y="260" as="geometry" />
        </mxCell>
        <mxCell id="merge" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" value="Merge to main" vertex="1">
          <mxGeometry height="70" width="230" x="40" y="410" as="geometry" />
        </mxCell>
        <mxCell id="note" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fillColor=none;strokeColor=none;" value="GitHub secrets needed: none (OIDC).&lt;br&gt;Repo variables (not secret): GCP project ID, WIF provider name, CI service account email." vertex="1">
          <mxGeometry height="100" width="270" x="40" y="640" as="geometry" />
        </mxCell>
        <mxCell id="gha" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#82b366;verticalAlign=top;align=left;spacingLeft=10;fontStyle=1;fontSize=12;container=1;collapsible=0;" value="GitHub Actions: deploy workflow&lt;br&gt;(on push to main, environment: production)" vertex="1">
          <mxGeometry height="760" width="320" x="350" y="30" as="geometry" />
        </mxCell>
        <mxCell id="s1" parent="gha" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" value="1. Build container image&lt;br&gt;(tag = git SHA)" vertex="1">
          <mxGeometry height="64" width="260" x="30" y="70" as="geometry" />
        </mxCell>
        <mxCell id="s2" parent="gha" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" value="2. Authenticate to GCP&lt;br&gt;GitHub OIDC token (no stored keys)" vertex="1">
          <mxGeometry height="64" width="260" x="30" y="170" as="geometry" />
        </mxCell>
        <mxCell id="s3" parent="gha" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" value="3. Push image to&lt;br&gt;Artifact Registry" vertex="1">
          <mxGeometry height="64" width="260" x="30" y="270" as="geometry" />
        </mxCell>
        <mxCell id="s4" parent="gha" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" value="4. Get GKE credentials&lt;br&gt;(CI service account)" vertex="1">
          <mxGeometry height="64" width="260" x="30" y="370" as="geometry" />
        </mxCell>
        <mxCell id="s5" parent="gha" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" value="5. Run DB migration Job&lt;br&gt;(wait for success)" vertex="1">
          <mxGeometry height="64" width="260" x="30" y="470" as="geometry" />
        </mxCell>
        <mxCell id="s6" parent="gha" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" value="6. Apply manifests&lt;br&gt;(kustomize, new image tag)" vertex="1">
          <mxGeometry height="64" width="260" x="30" y="570" as="geometry" />
        </mxCell>
        <mxCell id="s7" parent="gha" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" value="7. Verify rollout status&lt;br&gt;if failed: kubectl rollout undo" vertex="1">
          <mxGeometry height="64" width="260" x="30" y="670" as="geometry" />
        </mxCell>
        <mxCell id="wif" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" value="Workload Identity Federation&lt;br&gt;pool + provider locked to this repo&lt;br&gt;impersonates the CI service account" vertex="1">
          <mxGeometry height="90" width="290" x="920" y="187" as="geometry" />
        </mxCell>
        <mxCell id="ar" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" value="Artifact Registry" vertex="1">
