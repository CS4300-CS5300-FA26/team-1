        </mxCell>
        <mxCell id="gke" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" value="GKE Autopilot&lt;br&gt;namespace: app (prod)&lt;br&gt;CI permissions: this namespace only&lt;br&gt;(GCP IAM + Kubernetes RBAC)" vertex="1">
          <mxGeometry height="400" width="290" x="920" y="380" as="geometry" />
        </mxCell>
        <mxCell id="tf" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" value="Local machine&lt;br&gt;terraform apply, your own IAM&lt;br&gt;GKE, Cloud SQL, Artifact Registry,&lt;br&gt;WIF pool, CI service account" vertex="1">
          <mxGeometry height="120" width="250" x="1290" y="380" as="geometry" />
