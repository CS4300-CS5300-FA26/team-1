<mxfile host="app.diagrams.net">
  <diagram name="Meal plan data lineage" id="Meal-plan-data-lineage">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="800" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=14;fontStyle=1;fillColor=none;strokeColor=none;" value="Meal plan (D-5) data lineage: where its data comes from and where it goes (ADR-008)" vertex="1">
          <mxGeometry height="30" width="900" x="30" y="10" as="geometry" />
        </mxCell>

        <mxCell id="h-sources" parent="1" style="text;html=1;align=center;fontSize=12;fontStyle=1;fillColor=none;strokeColor=none;" value="Sources" vertex="1">
          <mxGeometry height="20" width="250" x="30" y="50" as="geometry" />
        </mxCell>
        <mxCell id="h-d5" parent="1" style="text;html=1;align=center;fontSize=12;fontStyle=1;fillColor=none;strokeColor=none;" value="D-5 meal plan (nutrition app)" vertex="1">
          <mxGeometry height="20" width="600" x="360" y="50" as="geometry" />
        </mxCell>
        <mxCell id="h-out" parent="1" style="text;html=1;align=center;fontSize=12;fontStyle=1;fillColor=none;strokeColor=none;" value="Consumers" vertex="1">
          <mxGeometry height="20" width="260" x="1080" y="50" as="geometry" />
        </mxCell>

        <mxCell id="fdc" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" value="USDA FoodData Central&lt;br&gt;SR Legacy (2018, public domain)&lt;br&gt;nutrients per 100 g, portion weights" vertex="1">
          <mxGeometry height="70" width="250" x="30" y="80" as="geometry" />
        </mxCell>
        <mxCell id="json" parent="1" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" value="nutrition/data/recipe_catalog.json&lt;br&gt;55 ingredients (each cites an FDC id),&lt;br&gt;25 recipes; no prices" vertex="1">
          <mxGeometry height="70" width="250" x="30" y="190" as="geometry" />
        </mxCell>
        <mxCell id="profile" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" value="Onboarding (core.UserProfile)&lt;br&gt;planned_meals, weekly_food_budget" vertex="1">
          <mxGeometry height="60" width="250" x="30" y="310" as="geometry" />
        </mxCell>
        <mxCell id="d4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;dashed=1;" value="D-4 Macro Generation&lt;br&gt;NUTRITION_MACRO_TARGETS_PROVIDER&lt;br&gt;7 daily macro targets" vertex="1">
          <mxGeometry height="70" width="250" x="30" y="410" as="geometry" />
        </mxCell>
        <mxCell id="dv" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" value="Fallback: FDA Daily Values&lt;br&gt;(nutrition/targets.py, 21 CFR 101.9)" vertex="1">
          <mxGeometry height="50" width="250" x="30" y="500" as="geometry" />
        </mxCell>
        <mxCell id="d6prices" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;dashed=1;" value="D-6 grocery prices&lt;br&gt;NUTRITION_GROCERY_PRICE_SOURCE&lt;br&gt;price quotes per ingredient&lt;br&gt;(fallback: no cost, no budget limit)" vertex="1">
          <mxGeometry height="80" width="250" x="30" y="590" as="geometry" />
        </mxCell>

        <mxCell id="loader" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" value="catalog_loader.py&lt;br&gt;after every migrate, or&lt;br&gt;manage.py load_recipe_catalog" vertex="1">
          <mxGeometry height="70" width="230" x="360" y="190" as="geometry" />
        </mxCell>
        <mxCell id="catalogdb" parent="1" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=12;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" value="PostgreSQL&lt;br&gt;Ingredient, CatalogRecipe,&lt;br&gt;RecipeLine" vertex="1">
          <mxGeometry height="90" width="230" x="360" y="300" as="geometry" />
        </mxCell>
        <mxCell id="services" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" value="services.py + planner.py&lt;br&gt;average price quotes (pricing.py),&lt;br&gt;fit each day to its targets,&lt;br&gt;cost the week in whole packages,&lt;br&gt;keep to the budget" vertex="1">
          <mxGeometry height="110" width="250" x="680" y="400" as="geometry" />
        </mxCell>
        <mxCell id="plandb" parent="1" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=12;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" value="PostgreSQL&lt;br&gt;WeeklyMealPlan, PlannedMealEntry&lt;br&gt;(one plan per user per week)" vertex="1">
          <mxGeometry height="90" width="250" x="680" y="190" as="geometry" />
        </mxCell>

        <mxCell id="page" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" value="Meal Plan page (/meal-plan/)&lt;br&gt;user's browser: week strip, meals,&lt;br&gt;recipes, totals, cost, notices" vertex="1">
          <mxGeometry height="70" width="260" x="1080" y="420" as="geometry" />
        </mxCell>
        <mxCell id="d6list" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;dashed=1;" value="D-6 Grocery List&lt;br&gt;combined ingredients, cost overview" vertex="1">
          <mxGeometry height="60" width="260" x="1080" y="205" as="geometry" />
        </mxCell>
        <mxCell id="d3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;dashed=1;" value="D-3 This Week (workouts)&lt;br&gt;NUTRITION_WORKOUTS_LINK&lt;br&gt;(dashboard until D-3 ships)" vertex="1">
          <mxGeometry height="70" width="260" x="1080" y="590" as="geometry" />
        </mxCell>

        <mxCell id="e1" edge="1" parent="1" source="fdc" target="json" style="endArrow=block;html=1;fontSize=11;" value="copied by FDC id">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" edge="1" parent="1" source="json" target="loader" style="endArrow=block;html=1;fontSize=11;" value="read">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3" edge="1" parent="1" source="loader" target="catalogdb" style="endArrow=block;html=1;fontSize=11;" value="validated, one transaction">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e4" edge="1" parent="1" source="catalogdb" target="services" style="endArrow=block;html=1;fontSize=11;edgeStyle=orthogonalEdgeStyle;" value="CatalogRecipeSource.recipes()">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e5" edge="1" parent="1" source="profile" target="services" style="endArrow=block;html=1;fontSize=11;edgeStyle=orthogonalEdgeStyle;" value="meals, budget">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e6" edge="1" parent="1" source="d4" target="services" style="endArrow=block;html=1;fontSize=11;dashed=1;edgeStyle=orthogonalEdgeStyle;" value="weekly_targets()">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e7" edge="1" parent="1" source="dv" target="services" style="endArrow=block;html=1;fontSize=11;edgeStyle=orthogonalEdgeStyle;" value="used until D-4 is connected">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e8" edge="1" parent="1" source="d6prices" target="services" style="endArrow=block;html=1;fontSize=11;dashed=1;edgeStyle=orthogonalEdgeStyle;" value="quotes(), averaged">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e9" edge="1" parent="1" source="services" target="plandb" style="endArrow=block;startArrow=block;html=1;fontSize=11;" value="store, or reuse while inputs are unchanged">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e10" edge="1" parent="1" source="services" target="page" style="endArrow=block;html=1;fontSize=11;" value="MealPlanResult">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e11" edge="1" parent="1" source="plandb" target="d6list" style="endArrow=block;html=1;fontSize=11;dashed=1;" value="stored_week_plan()">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e12" edge="1" parent="1" source="page" target="d3" style="endArrow=block;html=1;fontSize=11;dashed=1;" value="link only">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="legend" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fillColor=none;strokeColor=none;" value="&lt;b&gt;Legend&lt;/b&gt;&lt;br&gt;Solid box or line: built in D-5 today.&lt;br&gt;Dashed box or line: a teammate's connector (D-3, D-4, D-6), wired by changing one setting; see nutrition/ports.py.&lt;br&gt;Purple cylinders: PostgreSQL tables. Nothing calls the network at runtime; D-5 stores no prices." vertex="1">
          <mxGeometry height="80" width="600" x="360" y="600" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
