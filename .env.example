# Generate a key locally with:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=
DEBUG=True

# Comma separated values, e.g. example.com,localhost,127.0.0.1
ALLOWED_HOSTS=localhost,127.0.0.1

# Comma separated, include the scheme, e.g. https://example.com
CSRF_TRUSTED_ORIGINS=

# When commented out, defaults to sqlite. For local PostgreSQL see docs/configurations/project_initial_setup.md
#DB_ENGINE=
#DB_HOST=
#DB_NAME=
#DB_USER=
#DB_PASSWORD=
#DB_PORT=

# Spotify (story D-7, ADR-010). Leave all four empty to switch Spotify sign-in off; setting only some stops startup.
# Client id and secret: https://developer.spotify.com/dashboard (your app's Settings).
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Must exactly match a redirect URI registered in the dashboard. Spotify rejects "localhost", so browse the app at
# http://127.0.0.1:8000 and register this URI:
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8000/auth-callback/spotify
# Encrypts stored Spotify tokens. Generate with:
# uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SPOTIFY_TOKEN_ENCRYPTION_KEY=

